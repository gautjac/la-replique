{
  "name": "la-replique",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "dev:vite": "vite",
    "build": "node scripts/corpus-build.mjs && tsc -b && vite build",
    "corpus:sync": "node scripts/corpus-sync.mjs",
    "corpus:build": "node scripts/corpus-build.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "PATH=\"$(brew --prefix openjdk)/bin:$PATH\" firebase emulators:exec --only firestore --project demo-la-replique \"vitest run --config firebase/vitest.rules.config.ts\"",
    "emulators": "PATH=\"$(brew --prefix openjdk)/bin:$PATH\" firebase emulators:start --only firestore,auth --project demo-la-replique"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "firebase": "^12.19.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@netlify/functions": "^5.2.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.4"
  }
}
